@model IEnumerable<API.Controllers.MascotaWeb>
@{
    ViewBag.Title = "Maestro-Detalle";
    var objRazas = (IEnumerable<Conector.raza>)ViewBag.Razas;
}
<h2>Maestro-Detalle: razas y mascotas</h2>
<div class="row">
    <div class="col-md-3">
        <h3>Razas</h3>
        <ul>
            @foreach (var objRaza in objRazas)
            {
                <li>@Html.ActionLink(objRaza.nombre, "MaestroDetalle", new { codigo = objRaza.codigo })</li>
            }
        </ul>
    </div>
    <div class="col-md-9">
        <h3>Mascotas de la raza seleccionada</h3>
        <table class="table">
            <tr><th>Codigo</th><th>Nombre</th><th>Raza</th><th>Estado</th></tr>
            @foreach (var objMascota in Model)
            {
                <tr><td>@objMascota.id</td><td>@objMascota.nombre</td><td>@objMascota.raza</td><td>@objMascota.estado</td></tr>
            }
        </table>
    </div>
</div>
<p>@Html.ActionLink("Inicio", "Index", "Home")</p>